CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_esp32p4.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_VFS_MAX_COUNT=16

CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_HOSTED_AUTO_INIT=n

# 为 ESP-Hosted SDIO 和硬件加密保留内部 DMA 内存。
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# 将大型 TLS 上下文和记录缓冲区分配到 PSRAM，避免占用紧张的内部内存。
# ESP-Hosted SDIO 的 DMA 缓冲区仍使用上方预留的内部 DMA 内存池。
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_CAMERA_SC2336=y
CONFIG_CAMERA_SC2336_MIPI_RAW8_1280x720_30FPS=n
CONFIG_CAMERA_SC2336_MIPI_RAW10_1280x720_30FPS=y

CONFIG_CAMERA_OV2710=y
CONFIG_CAMERA_OV2710_MIPI_RAW10_1280X720_25FPS=y
# SurvivalOS: the 1280x720 mode is a crop of the sensor ("Cropped 720p" in
# OmniVision's own product brief); 1920x1080 reads the whole array, which gives
# the upright preview half as much zoom again. 720p stays built in.
CONFIG_CAMERA_OV2710_MIPI_RAW10_1920X1080_25FPS=y
CONFIG_CAMERA_OV2710_MIPI_DEFAULT_FMT_RAW10_1920X1080_25FPS=y

CONFIG_CAMERA_OV5645=y
CONFIG_CAMERA_OV5645_MIPI_RGB565_1280X960_30FPS=y
CONFIG_CAMERA_OV5645_MIPI_YUV422_1280X960_30FPS=n

CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# --- SurvivalOS: T-Display-P4 V1.0 has an ESP32-C6 co-processor ---
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y

# --- SurvivalOS: T-Display-P4 V1.0 carries ESP32-P4 silicon rev v1.x ---
# ESP-IDF >= 5.5.3 defaults to rev >= 3.x, and such an image is refused by the
# bootloader on this board. Rev <3 and rev >=3 builds are mutually exclusive.
# The vendor release images are built the same way (header: min 0.0, max 1.99).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

# SurvivalOS: the phone writes the ESP32-C6 firmware itself over SDIO with its
# own port (main/hal/device/common/coprocessor_sdio.cpp), so none of the
# library's ports are built.
CONFIG_SERIAL_FLASHER_PORT_UART=n
CONFIG_SERIAL_FLASHER_PORT_SDIO=n
CONFIG_SERIAL_FLASHER_LOG_LEVEL_INFO=y

# SurvivalOS: "svos tasks" on the serial port reports per-task CPU load.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# SurvivalOS: 30 frames per second instead of 100. Drawing the 568x1232 panel
# takes longer than 10 ms anyway, so the higher rate only kept the CPU busy.
CONFIG_LV_DEF_REFR_PERIOD=33
